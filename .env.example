# Copier ce fichier vers .env et renseigner les vraies valeurs.
# .env est dans .gitignore — ne JAMAIS committer les valeurs réelles.

PGDATABASE=eduai_afrique
PGUSER=postgres
PGHOST=/var/run/postgresql
# En prod, PGHOST est généralement une adresse réseau (ex: db.xxxx.supabase.co)

JWT_SECRET_KEY=change-moi-en-production-avec-une-valeur-aleatoire-longue

MISTRAL_API_KEY=
